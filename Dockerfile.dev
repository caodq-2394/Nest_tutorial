FROM node:22-alpine

WORKDIR /usr/src/app

# Chỉ copy package.json để tận dụng cache của Docker cho node_modules
COPY package*.json ./

RUN npm install

# Copy toàn bộ mã nguồn vào container
COPY . .

# Mở port 3000 (port mặc định của NestJS)
EXPOSE 3000

# Chạy lệnh start:dev có sẵn trong package.json của bạn
CMD ["npm", "run", "start:dev"]
