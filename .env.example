# Railway Postgres: reference these variables from the Postgres service,
# or paste the private DATABASE_URL supplied by Railway.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
DB_SSL=false
DB_SYNCHRONIZE=false

# Kafka is optional. Keep it off on Railway until a Kafka provider is configured.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=app.events
KAFKA_CLIENT_ID=nest-tutorial-api
KAFKA_CONSUMER_GROUP=nest-tutorial-api

# Set these for a managed Kafka provider (for example Upstash/Confluent Cloud).
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
